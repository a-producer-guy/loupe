# Loupe app settings. Copy to app/.env.local (never commit the real file).
# scripts/setup-b2.mjs, scripts/setup-supabase.mjs and scripts/migrate.ts fill these in for you.

# Supabase (Loupe's own project) > Project Settings > API.
# Used on the server only, for sign-in emails; the browser never sees them.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# The loupe_app database login (written by scripts/migrate.ts).
DATABASE_URL=

# Backblaze B2: the APP key (read and write; no delete).
B2_ENDPOINT=
B2_REGION=
B2_BUCKET=loupe-footage
B2_KEY_ID=
B2_APP_KEY=

# The app's public address, for sign-in links. Defaults to the address in the browser.
# APP_URL=https://loupe.reelarc.com

# Local testing only (npm run dev without Supabase): act as this person.
# Ignored by production builds.
# DEV_SIGN_IN_AS=you@example.com
