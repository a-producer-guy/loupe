# Footage app settings. Copy to app/.env.local (never commit the real file).
# scripts/setup-b2.mjs and scripts/migrate.ts fill most of these in for you.

# Supabase (Reelarc backend project) > Project Settings > API.
# Used on the server only, for sign-in emails; the browser never sees them.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# The footage_app database login (written by scripts/migrate.ts).
DATABASE_URL=

# Backblaze B2: the APP key (read and write; no delete in Phase 1).
B2_ENDPOINT=
B2_REGION=
B2_BUCKET=reelarc-footage
B2_KEY_ID=
B2_APP_KEY=

# Optional: the app's public address, for sign-in links. Defaults to the address in the browser.
# APP_URL=https://footage.reelarc.com

# Local testing only (npm run dev without Supabase): act as this team member.
# Ignored by production builds.
# DEV_SIGN_IN_AS=guy@reelarc.com
