# Proxy worker settings. Copy to worker/.env (never commit the real file).
# scripts/setup-b2.mjs and app/scripts/migrate.ts fill these in for you.

# Same loupe_app database login the app uses.
DATABASE_URL=

# Backblaze B2: the WORKER key, which can read and write but not delete.
B2_ENDPOINT=
B2_REGION=
B2_BUCKET=loupe-footage
B2_KEY_ID=
B2_APP_KEY=

# Optional
# WORKER_CONCURRENCY=2
# POLL_SECONDS=5
